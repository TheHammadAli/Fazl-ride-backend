NODE_ENV=development
PORT=3000

# Pooled URL for the app. Direct/session-pooler URL for migrations (Supabase).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fazl?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/fazl?schema=public"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me
OTP_SECRET=change-me
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
OTP_TTL_SECONDS=300

# Comma-separated phones (E.164) that get the super_admin role after OTP login
SUPER_ADMIN_PHONES=+923000000000

# --- Supabase (used only as Postgres + object storage; not Auth / RLS) ---
# To use Supabase as the database, replace the two URLs above:
#   DATABASE_URL = Transaction pooler string (port 6543)
#   DIRECT_URL   = Session pooler string (port 5432, user postgres.<project-ref>)
# Do not use the db.<ref>.supabase.co direct host: it is IPv6-only (fails on IPv4 networks and on Render).
# Add ?sslmode=require to both if the connection is refused.
SUPABASE_URL=https://<project-ref>.supabase.co
# Server-side secret. Never ship it in the mobile app or commit it.
SUPABASE_SERVICE_ROLE_KEY=
# Create this bucket in the Supabase dashboard and keep it PRIVATE.
SUPABASE_BUCKET=driver-documents

# Supabase root CA so the app can verify the database connection (used with the Supabase URLs above)
# DATABASE_SSL_CA=certs/supabase-ca-2021.crt

# Scratch database for `prisma migrate dev` (same server as DIRECT_URL, database named fazl_shadow).
# On Supabase create it once with: create database fazl_shadow;
# SHADOW_DATABASE_URL=

# --- Ride matching (all optional, defaults shown) ---
# RIDE_PRICING_MODE=bidding         "bidding" (InDrive-style: broadcast, drivers propose a
#                                   price, the passenger chooses) or "fixed" (the original
#                                   Uber/Careem style: nearest few drivers, first to accept)
# NEGOTIABLE_RADIUS_METERS=50000    how far a negotiable ride is broadcast (default: the whole city)
# NEGOTIABLE_OFFERS_LIMIT=300       how many drivers a negotiable ride can be offered to at once
# RIDE_REQUEST_TTL_SECONDS=120      how long a request stays open
# OFFER_TTL_SECONDS=30              time a driver has to answer, and how often the search widens
# OFFERS_PER_ROUND=5                drivers offered per round (fixed-price mode only)
# RIDE_SEARCH_RADII_METERS=3000,5000,8000
# MATCHING_TICK_MS=5000
# ARRIVAL_RADIUS_METERS=300        how close the driver must be to press Arrived
# MAX_FARE_FACTOR=3                final fare is capped at this multiple of the estimate
# MATCHING_SWEEPER=on               "off" disables the background sweeper
# DRIVER_LOCATION_TTL_SECONDS=60    a driver position older than this is not "nearby"
# BUSINESS_TZ_OFFSET_MINUTES=300    what "today" means for dashboards (Pakistan = UTC+5)

# --- Cancellation cool-down, ratings, rate limit (optional, defaults shown) ---
# CANCEL_LIMIT=3                    this many cancellations after a ride was accepted ...
# CANCEL_WINDOW_MINUTES=60          ... within this many minutes ...
# CANCEL_COOLDOWN_MINUTES=30        ... blocks the person (passenger from booking, driver from taking rides) for this long
# CANCEL_RULE=on                    "off" disables the rule
# RATING_WINDOW_DAYS=7              how long after completion a ride can still be rated
# THROTTLE_LIMIT=300                requests per minute per signed-in session (per IP before login)

# --- Order tracking (optional, defaults shown) ---
# TRACKING_TOKEN_TTL_HOURS=24         how long a customer tracking link works
# INTEGRATION_THROTTLE_LIMIT=6000     requests per minute per API key on /integrations/orders

# --- Idle drivers (optional, defaults shown) ---
# DRIVER_OFFLINE_AFTER_SECONDS=300   an online driver silent this long is put offline
# PRESENCE_TICK_MS=30000             how often the check runs
# PRESENCE_SWEEPER=on                "off" disables it

# --- Testing only: log in with no real SMS (optional, off by default) ---
# DEV_OTP_BYPASS=true               any phone number logs in with DEV_OTP_CODE, no SMS needed
# DEV_OTP_CODE=123456               the fixed code, when the bypass is on
# NEVER set DEV_OTP_BYPASS=true on a server real users can reach.

# --- Testing only: skip waiting for an admin (optional, off by default) ---
# DEV_AUTO_APPROVE_DRIVERS=true     the moment a driver's uploaded documents
#                                   satisfy the requirements, they are approved
#                                   automatically - the real apply/upload
#                                   screens still run, only the admin's click
#                                   is skipped.
# NEVER set DEV_AUTO_APPROVE_DRIVERS=true on a server real drivers reach.
