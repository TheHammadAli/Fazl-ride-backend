generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  customer
  driver
  parking_operator
  admin
  super_admin
}

enum UserStatus {
  active
  blocked
  deleted
}

enum DriverStatus {
  pending
  approved
  rejected
  suspended
}

enum VehicleStatus {
  pending
  approved
  rejected
}

enum VehicleCategory {
  economy
  comfort
  xl
}

enum DocumentType {
  cnic_front
  cnic_back
  license_front
  license_back
  selfie
  vehicle_registration
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  phone         String     @unique
  name          String?
  email         String?    @unique
  avatarKey     String?
  status        UserStatus @default(active)
  blockedReason String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  roles         UserRole[]
  refreshTokens RefreshToken[]
  driverProfile DriverProfile?

  @@map("users")
}

// One user can hold several roles (e.g. customer + driver).
model UserRole {
  userId    String   @db.Uuid
  role      Role
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

model OtpCode {
  id         String    @id @default(uuid()) @db.Uuid
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
  @@map("otp_codes")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// "Become a Driver": created when a customer applies, approved by an admin.
model DriverProfile {
  id               String       @id @default(uuid()) @db.Uuid
  userId           String       @unique @db.Uuid
  cnic             String       @unique
  licenseNumber    String
  status           DriverStatus @default(pending)
  rejectionReason  String?
  suspensionReason String?
  reviewedById     String?      @db.Uuid
  reviewedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicles  Vehicle[]
  documents DriverDocument[]

  @@index([status])
  @@map("driver_profiles")
}

model Vehicle {
  id              String          @id @default(uuid()) @db.Uuid
  driverProfileId String          @db.Uuid
  category        VehicleCategory @default(economy)
  make            String
  model           String
  year            Int
  color           String
  plateNumber     String          @unique
  status          VehicleStatus   @default(pending)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  driverProfile DriverProfile    @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  documents     DriverDocument[]

  @@index([driverProfileId])
  @@map("vehicles")
}

// Metadata for a file kept in object storage. The file itself is private and
// only ever served through short-lived signed URLs. `vehicleId` is set for
// vehicle_registration; the other types belong to the driver.
model DriverDocument {
  id              String       @id @default(uuid()) @db.Uuid
  driverProfileId String       @db.Uuid
  vehicleId       String?      @db.Uuid
  type            DocumentType
  storageKey      String       @unique
  mimeType        String
  sizeBytes       Int
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  driverProfile DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  vehicle       Vehicle?      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([driverProfileId])
  @@index([vehicleId])
  @@map("driver_documents")
}

// Credentials for external systems (FAZL app, parking sensors, partners).
// Only a hash is stored; the plain key is shown once when it is created.
model ApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  prefix      String    @unique
  keyHash     String    @unique
  scopes      String[]
  createdById String?   @db.Uuid
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@map("api_keys")
}

// Who did what in the admin API (approvals, blocks, key management).
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  targetType String
  targetId   String
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId])
  @@map("audit_logs")
}

// Fare rules per vehicle category, in PKR whole rupees (rates per km / minute can be fractional).
model FareConfig {
  category        VehicleCategory @id
  baseFare        Int
  perKm           Float
  perMinute       Float
  minimumFare     Int
  cancellationFee Int
  updatedAt       DateTime        @updatedAt

  @@map("fare_configs")
}
