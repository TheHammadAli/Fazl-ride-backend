generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  customer
  driver
  parking_operator
  admin
  super_admin
}

enum UserStatus {
  active
  blocked
  deleted
}

enum DriverStatus {
  pending
  approved
  rejected
  suspended
}

enum VehicleStatus {
  pending
  approved
  rejected
}

enum VehicleCategory {
  economy
  comfort
  xl
}

enum DocumentType {
  cnic_front
  cnic_back
  license_front
  license_back
  selfie
  vehicle_registration
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  phone         String     @unique
  name          String?
  email         String?    @unique
  avatarKey     String?
  status        UserStatus @default(active)
  blockedReason String?
  // Sum and number of star ratings received, so the average is cheap to show on cards.
  ratingSum     Int        @default(0)
  ratingCount   Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  roles            UserRole[]
  refreshTokens    RefreshToken[]
  driverProfile    DriverProfile?
  ridesAsPassenger Ride[]             @relation("RidePassenger")
  ridesAsDriver    Ride[]             @relation("RideDriver")
  rideOffers       RideOffer[]
  cancellations    RideCancellation[]
  ratingsGiven     RideRating[]       @relation("RatingRater")
  ratingsReceived  RideRating[]       @relation("RatingRatee")
  earnings         DriverEarning[]

  @@map("users")
}

// One user can hold several roles (e.g. customer + driver).
model UserRole {
  userId    String   @db.Uuid
  role      Role
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

model OtpCode {
  id         String    @id @default(uuid()) @db.Uuid
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
  @@map("otp_codes")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// "Become a Driver": created when a customer applies, approved by an admin.
model DriverProfile {
  id               String       @id @default(uuid()) @db.Uuid
  userId           String       @unique @db.Uuid
  cnic             String       @unique
  licenseNumber    String
  status           DriverStatus @default(pending)
  rejectionReason  String?
  suspensionReason String?
  reviewedById     String?      @db.Uuid
  reviewedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicles  Vehicle[]
  documents DriverDocument[]

  @@index([status])
  @@map("driver_profiles")
}

model Vehicle {
  id              String          @id @default(uuid()) @db.Uuid
  driverProfileId String          @db.Uuid
  category        VehicleCategory @default(economy)
  make            String
  model           String
  year            Int
  color           String
  plateNumber     String          @unique
  status          VehicleStatus   @default(pending)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  driverProfile DriverProfile    @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  documents     DriverDocument[]
  rides         Ride[]

  @@index([driverProfileId])
  @@map("vehicles")
}

// Metadata for a file kept in object storage. The file itself is private and
// only ever served through short-lived signed URLs. `vehicleId` is set for
// vehicle_registration; the other types belong to the driver.
model DriverDocument {
  id              String       @id @default(uuid()) @db.Uuid
  driverProfileId String       @db.Uuid
  vehicleId       String?      @db.Uuid
  type            DocumentType
  storageKey      String       @unique
  mimeType        String
  sizeBytes       Int
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  driverProfile DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  vehicle       Vehicle?      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([driverProfileId])
  @@index([vehicleId])
  @@map("driver_documents")
}

// Credentials for external systems (FAZL app, parking sensors, partners).
// Only a hash is stored; the plain key is shown once when it is created.
model ApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  prefix      String    @unique
  keyHash     String    @unique
  scopes      String[]
  createdById String?   @db.Uuid
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@map("api_keys")
}

// Who did what in the admin API (approvals, blocks, key management).
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  targetType String
  targetId   String
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId])
  @@map("audit_logs")
}

// Fare rules per vehicle category, in PKR whole rupees (rates per km / minute can be fractional).
model FareConfig {
  category    VehicleCategory @id
  baseFare    Int
  perKm       Float
  perMinute   Float
  minimumFare Int
  updatedAt   DateTime        @updatedAt

  @@map("fare_configs")
}

// Live state of a driver in Driver mode: online/offline, the vehicle in use and
// the last known position. `location` is a PostGIS geography written with raw
// SQL (Prisma cannot write Unsupported columns).
model DriverPresence {
  userId            String                                @id @db.Uuid
  vehicleId         String                                @db.Uuid
  category          VehicleCategory
  isOnline          Boolean                               @default(false)
  busy              Boolean                               @default(false)
  location          Unsupported("geography(Point,4326)")?
  heading           Float?
  speedKmh          Float?
  locationUpdatedAt DateTime?
  onlineSince       DateTime?
  updatedAt         DateTime                              @updatedAt

  @@index([location], type: Gist)
  @@index([isOnline, category])
  @@map("driver_presence")
}

// One row per stretch of being online, used for "Online Hours" on the dashboard.
model DriverSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([userId, startedAt])
  @@map("driver_sessions")
}

enum RideStatus {
  requested
  accepted
  arrived
  started
  completed
  cancelled
  expired
}

enum OfferStatus {
  pending
  accepted
  declined
  expired
}

enum PaymentMethod {
  cash
}

enum CancelledBy {
  passenger
  driver
  system
}

// A ride from request to completion. Coordinates are plain floats here: the
// fast spatial search happens on driver_presence, not on rides.
model Ride {
  id          String          @id @default(uuid()) @db.Uuid
  passengerId String          @db.Uuid
  driverId    String?         @db.Uuid
  vehicleId   String?         @db.Uuid
  category    VehicleCategory
  status      RideStatus      @default(requested)

  pickupLat      Float
  pickupLng      Float
  pickupAddress  String
  dropoffLat     Float
  dropoffLng     Float
  dropoffAddress String

  estimatedDistanceMeters  Int
  estimatedDurationSeconds Int
  estimatedFare            Int

  // Filled in when the ride completes (B4).
  distanceMeters  Int?
  durationSeconds Int?
  fare            Int?

  paymentMethod       PaymentMethod @default(cash)
  cancelledBy         CancelledBy?
  // Which state the ride was in when it was cancelled (for cancellation statistics).
  cancelledFromStatus RideStatus?
  cancelReason        String?

  // Rates the passenger was quoted, so the final fare uses the same prices even
  // if an admin changes the fare config while the ride is in progress.
  rates Json?

  // Distance driven since the ride started, summed from the driver's location updates.
  trackedMeters Float  @default(0)
  lastLat       Float?
  lastLng       Float?

  // Matching: the search widens step by step until someone accepts or the request expires.
  searchStep         Int      @default(0)
  searchRadiusMeters Int
  nextExpandAt       DateTime
  expiresAt          DateTime

  requestedAt DateTime  @default(now())
  acceptedAt  DateTime?
  arrivedAt   DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  updatedAt   DateTime  @updatedAt

  passenger       User               @relation("RidePassenger", fields: [passengerId], references: [id])
  driver          User?              @relation("RideDriver", fields: [driverId], references: [id])
  vehicle         Vehicle?           @relation(fields: [vehicleId], references: [id])
  offers          RideOffer[]
  ratings         RideRating[]
  cancellationLog RideCancellation[]
  earningEntries  DriverEarning[]

  @@index([passengerId, status])
  @@index([driverId, status])
  @@index([status, expiresAt])
  @@map("rides")
}

// One offer of a ride to one driver. The first driver to accept wins.
model RideOffer {
  id                     String      @id @default(uuid()) @db.Uuid
  rideId                 String      @db.Uuid
  driverId               String      @db.Uuid
  status                 OfferStatus @default(pending)
  distanceToPickupMeters Int
  etaSeconds             Int
  offeredAt              DateTime    @default(now())
  expiresAt              DateTime
  respondedAt            DateTime?

  ride   Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)
  driver User @relation(fields: [driverId], references: [id])

  @@unique([rideId, driverId])
  @@index([driverId, status])
  @@map("ride_offers")
}

enum CancellationRole {
  passenger
  driver
}

// Every time someone backs out of a ride the other person was already waiting for.
// Used for the cool-down rule (too many in a short time) and for statistics.
model RideCancellation {
  id         String           @id @default(uuid()) @db.Uuid
  rideId     String           @db.Uuid
  userId     String           @db.Uuid
  role       CancellationRole
  fromStatus RideStatus
  reason     String?
  // Set by an admin to wipe the slate; forgiven rows no longer count.
  forgivenAt DateTime?
  createdAt  DateTime         @default(now())

  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, role, createdAt])
  @@map("ride_cancellations")
}

// One rating from one person on a ride to the other person on it.
model RideRating {
  id        String   @id @default(uuid()) @db.Uuid
  rideId    String   @db.Uuid
  raterId   String   @db.Uuid
  rateeId   String   @db.Uuid
  stars     Int
  comment   String?
  createdAt DateTime @default(now())

  ride  Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)
  rater User @relation("RatingRater", fields: [raterId], references: [id])
  ratee User @relation("RatingRatee", fields: [rateeId], references: [id])

  @@unique([rideId, raterId])
  @@index([rateeId])
  @@map("ride_ratings")
}

enum EarningType {
  ride_fare
  adjustment
  cashout
}

// A driver's earnings ledger. Amounts are signed PKR. No commission is taken for
// now, so a completed ride adds its full fare. `cashout` is reserved for when
// wallets / online payments exist and is not shown in the app yet.
model DriverEarning {
  id        String      @id @default(uuid()) @db.Uuid
  driverId  String      @db.Uuid
  type      EarningType
  amount    Int
  rideId    String?     @db.Uuid
  note      String?
  createdAt DateTime    @default(now())

  driver User  @relation(fields: [driverId], references: [id])
  ride   Ride? @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@unique([rideId, type])
  @@index([driverId, createdAt])
  @@map("driver_earnings")
}
