generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  customer
  driver
  parking_operator
  admin
  super_admin
}

enum UserStatus {
  active
  blocked
}

enum DriverStatus {
  pending
  approved
  rejected
  suspended
}

enum VehicleStatus {
  pending
  approved
  rejected
}

enum VehicleCategory {
  economy
  comfort
  xl
}

enum DocumentType {
  cnic_front
  cnic_back
  license_front
  license_back
  selfie
  vehicle_registration
}

model User {
  id        String     @id @default(uuid()) @db.Uuid
  phone     String     @unique
  name      String?
  email     String?    @unique
  avatarUrl String?
  status    UserStatus @default(active)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  roles         UserRole[]
  refreshTokens RefreshToken[]
  driverProfile DriverProfile?

  @@map("users")
}

// One user can hold several roles (e.g. customer + driver).
model UserRole {
  userId    String   @db.Uuid
  role      Role
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

model OtpCode {
  id         String    @id @default(uuid()) @db.Uuid
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
  @@map("otp_codes")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// "Become a Driver": created when a customer applies, approved by an admin.
model DriverProfile {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @unique @db.Uuid
  cnic            String       @unique
  licenseNumber   String
  status          DriverStatus @default(pending)
  rejectionReason String?
  reviewedById    String?      @db.Uuid
  reviewedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicles  Vehicle[]
  documents DriverDocument[]

  @@index([status])
  @@map("driver_profiles")
}

model Vehicle {
  id              String          @id @default(uuid()) @db.Uuid
  driverProfileId String          @db.Uuid
  category        VehicleCategory @default(economy)
  make            String
  model           String
  year            Int
  color           String
  plateNumber     String          @unique
  status          VehicleStatus   @default(pending)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  driverProfile DriverProfile    @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  documents     DriverDocument[]

  @@index([driverProfileId])
  @@map("vehicles")
}

// Metadata for a file kept in object storage. The file itself is private and
// only ever served through short-lived signed URLs. `vehicleId` is set for
// vehicle_registration; the other types belong to the driver.
model DriverDocument {
  id              String       @id @default(uuid()) @db.Uuid
  driverProfileId String       @db.Uuid
  vehicleId       String?      @db.Uuid
  type            DocumentType
  storageKey      String       @unique
  mimeType        String
  sizeBytes       Int
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  driverProfile DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  vehicle       Vehicle?      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([driverProfileId])
  @@index([vehicleId])
  @@map("driver_documents")
}
