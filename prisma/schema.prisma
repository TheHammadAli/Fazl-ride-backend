generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  customer
  driver
  parking_operator
  admin
  super_admin
}

enum UserStatus {
  active
  blocked
  deleted
}

// Within one city (the original flow) vs between two cities (long trips:
// different fare card, no change to matching - a driver is still found near
// the pickup point regardless of how far the drop-off is).
enum TripType {
  within_city
  city_to_city
}

enum DriverStatus {
  pending
  approved
  rejected
  suspended
}

enum VehicleStatus {
  pending
  approved
  rejected
}

// The kinds of vehicle a passenger can pick, e.g. bike/car - admin-managed
// (see admin/vehicle-categories) instead of a fixed Postgres enum, so a new
// one (e.g. rickshaw) can be added without a deploy. `key` is the stable id
// used everywhere else (rides, vehicles, driver_presence, fare_configs).
// `iconKey` must be one of the small set of icons the client apps already
// know how to draw (see docs/VEHICLE_CATEGORIES.md) - adding a category with
// an unrecognised iconKey just falls back to a generic vehicle icon on
// clients until they are updated to recognise it.
model VehicleCategory {
  key         String   @id
  label       String
  iconKey     String
  // Which service lists it: 'ride' (passengers) or 'freight' (goods: loader
  // rickshaw, pickup, truck, dumper...).
  service     String   @default("ride")
  // Ride tiers (Mini, AC, Business...): set on a tier, the base type its
  // vehicles are registered as (car). Null for a base type. A tier with no
  // requirement below is open to every vehicle of the base type; one with a
  // requirement needs an admin to approve each vehicle for it.
  parentKey   String?
  // One line for passengers ("Air-conditioned, newer cars").
  description String?
  requiresAc  Boolean  @default(false)
  minYear     Int?
  // Lowercase make/model words a vehicle must match (empty = any).
  models      String[] @default([])
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vehicles        Vehicle[]
  rides           Ride[]
  driverPresences DriverPresence[]
  fareConfigs     FareConfig[]

  @@map("vehicle_categories")
}

enum DocumentType {
  cnic_front
  cnic_back
  license_front
  license_back
  selfie
  vehicle_registration
  // The vehicle from the front or back with its number plate readable.
  vehicle_photo
}

model User {
  id               String     @id @default(uuid()) @db.Uuid
  phone            String     @unique
  name             String?
  email            String?    @unique
  // Only set for web-admin accounts (email + password login); everyone else uses an OTP.
  passwordHash     String?
  avatarKey        String?
  // Someone to call or alert in an emergency (SOS). Drivers keep theirs on
  // the driver profile too, where it is required to drive.
  emergencyContact String?
  status           UserStatus @default(active)
  blockedReason    String?
  // Sum and number of star ratings received, so the average is cheap to show on cards.
  ratingSum        Int        @default(0)
  ratingCount      Int        @default(0)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  roles             UserRole[]
  refreshTokens     RefreshToken[]
  driverProfile     DriverProfile?
  ridesAsPassenger  Ride[]              @relation("RidePassenger")
  ridesAsDriver     Ride[]              @relation("RideDriver")
  rideOffers        RideOffer[]
  cancellations     RideCancellation[]
  ratingsGiven      RideRating[]        @relation("RatingRater")
  ratingsReceived   RideRating[]        @relation("RatingRatee")
  earnings          DriverEarning[]
  sentRideMessages  RideMessage[]
  driverDestination DriverDestination?
  wallet            Wallet?
  walletEntries     WalletTransaction[]
  walletRequests    WalletRequest[]
  devices           DeviceToken[]
  savedPlaces       SavedPlace[]
  rideSchedules     RideSchedule[]
  safetyAlerts      SafetyAlert[]       @relation("SafetyAlertUser")
  supportTickets    SupportTicket[]     @relation("TicketUser")
  ticketsAgainst    SupportTicket[]     @relation("TicketAgainst")
  ticketMessages    SupportMessage[]

  @@map("users")
}

// One user can hold several roles (e.g. customer + driver).
model UserRole {
  userId    String   @db.Uuid
  role      Role
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

model OtpCode {
  id         String    @id @default(uuid()) @db.Uuid
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
  @@map("otp_codes")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// "Become a Driver": created when a customer applies, approved by an admin.
model DriverProfile {
  id               String       @id @default(uuid()) @db.Uuid
  userId           String       @unique @db.Uuid
  cnic             String       @unique
  licenseNumber    String
  // Null only for drivers who applied before these became required; such a
  // driver cannot go online until they fill them in (see driver-requirements).
  licenseExpiry    DateTime?    @db.Date
  dateOfBirth      DateTime?    @db.Date
  emergencyContact String?
  // Set when the driver presses "Submit for review" (or an approved driver's
  // identity changed); null while still a draft and again after a rejection.
  submittedAt      DateTime?
  // What the admin flagged on a rejection, as [{field, message, vehicleId?}];
  // an entry is removed as soon as the driver fixes that field or document.
  reviewIssues     Json?
  status           DriverStatus @default(pending)
  // The achievement level reached (Silver, Gold...), kept to notice a new
  // one and to give each level's bonus once. Null below the first level.
  levelKey         String?
  rejectionReason  String?
  suspensionReason String?
  reviewedById     String?      @db.Uuid
  reviewedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicles  Vehicle[]
  documents DriverDocument[]

  @@index([status])
  @@map("driver_profiles")
}

model Vehicle {
  id              String        @id @default(uuid()) @db.Uuid
  driverProfileId String        @db.Uuid
  category        String        @default("car")
  make            String
  model           String
  year            Int
  color           String
  plateNumber     String        @unique
  // What the driver said; checked by the admin.
  hasAc           Boolean       @default(false)
  // Tiers with requirements this vehicle is approved for (by an admin).
  tiers           String[]      @default([])
  // Tiers the driver chose not to get requests for.
  tiersOff        String[]      @default([])
  status          VehicleStatus @default(pending)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  driverProfile DriverProfile    @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  categoryRef   VehicleCategory  @relation(fields: [category], references: [key])
  documents     DriverDocument[]
  rides         Ride[]

  @@index([driverProfileId])
  @@index([category])
  @@map("vehicles")
}

// Metadata for a file kept in object storage. The file itself is private and
// only ever served through short-lived signed URLs. `vehicleId` is set for
// vehicle_registration and vehicle_photo; the other types belong to the driver.
model DriverDocument {
  id              String       @id @default(uuid()) @db.Uuid
  driverProfileId String       @db.Uuid
  vehicleId       String?      @db.Uuid
  type            DocumentType
  storageKey      String       @unique
  mimeType        String
  sizeBytes       Int
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  driverProfile DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  vehicle       Vehicle?      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([driverProfileId])
  @@index([vehicleId])
  @@map("driver_documents")
}

// Credentials for external systems (FAZL app, parking sensors, partners).
// Only a hash is stored; the plain key is shown once when it is created.
model ApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  prefix      String    @unique
  keyHash     String    @unique
  scopes      String[]
  createdById String?   @db.Uuid
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@map("api_keys")
}

// Who did what in the admin API (approvals, blocks, key management).
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  targetType String
  targetId   String
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId])
  @@map("audit_logs")
}

// Fare rules per vehicle category, in PKR whole rupees (rates per km / minute can be fractional).
model FareConfig {
  category    String
  tripType    TripType @default(within_city)
  baseFare    Int
  perKm       Float
  perMinute   Float
  minimumFare Int
  updatedAt   DateTime @updatedAt

  categoryRef VehicleCategory @relation(fields: [category], references: [key])

  @@id([category, tripType])
  @@map("fare_configs")
}

// Live state of a driver in Driver mode: online/offline, the vehicle in use and
// the last known position. `location` is a PostGIS geography written with raw
// SQL (Prisma cannot write Unsupported columns).
model DriverPresence {
  userId            String                                @id @db.Uuid
  vehicleId         String                                @db.Uuid
  category          String
  // Every ride type this driver can be offered right now (base type and
  // tiers), worked out when they go online or their tiers change.
  categories        String[]                              @default([])
  isOnline          Boolean                               @default(false)
  busy              Boolean                               @default(false)
  location          Unsupported("geography(Point,4326)")?
  heading           Float?
  speedKmh          Float?
  locationUpdatedAt DateTime?
  onlineSince       DateTime?
  updatedAt         DateTime                              @updatedAt

  categoryRef VehicleCategory @relation(fields: [category], references: [key])

  @@index([location], type: Gist)
  @@index([isOnline, category])
  @@map("driver_presence")
}

// A driver's destination mode ("Go Home" / Uber destination filter): while
// active, only rides that take them towards this place are offered. A few
// uses per business day (usesDay/usesCount), each lasting a few hours.
model DriverDestination {
  userId    String    @id @db.Uuid
  lat       Float
  lng       Float
  address   String
  active    Boolean   @default(false)
  expiresAt DateTime?
  usesDay   DateTime?
  usesCount Int       @default(0)
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("driver_destinations")
}

// One row per stretch of being online, used for "Online Hours" on the dashboard.
model DriverSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([userId, startedAt])
  @@map("driver_sessions")
}

enum RideStatus {
  // Booked for later (Ride Later / scheduled freight): no driver is asked
  // until dispatchAt, when it becomes requested.
  scheduled
  requested
  accepted
  arrived
  started
  completed
  cancelled
  expired
}

enum OfferStatus {
  pending
  // The driver answered with a price (their own, or the suggested one as-is);
  // the passenger has not chosen yet.
  bid
  accepted
  declined
  expired
  // Another driver's offer was chosen for this ride.
  closed
}

enum PaymentMethod {
  cash
  // Paid from the passenger's wallet when the ride completes; whatever the
  // balance does not cover is collected in cash.
  wallet
}

enum CancelledBy {
  passenger
  driver
  system
}

// A ride from request to completion. Coordinates are plain floats here: the
// fast spatial search happens on driver_presence, not on rides.
model Ride {
  id              String     @id @default(uuid()) @db.Uuid
  passengerId     String     @db.Uuid
  driverId        String?    @db.Uuid
  vehicleId       String?    @db.Uuid
  category        String
  tripType        TripType   @default(within_city)
  status          RideStatus @default(requested)
  // Booked for later (Ride Later): when the customer wants it. Null for a
  // ride wanted now. The confirmed driver starts it themselves (inDrive
  // style); see BookingSettings for the windows.
  scheduledAt     DateTime?
  // The confirmed driver never started the booking.
  noShow          Boolean    @default(false)
  // Made by a Frequent traveler schedule (one booking per day it runs).
  scheduleId      String?    @db.Uuid
  // 'ride' or 'freight'. A freight booking goes to every nearby driver of
  // its vehicle type, who accept or counter the offered fare.
  service         String     @default("ride")
  loadDescription String?
  loadWeightKg    Int?
  helpersNeeded   Int?
  // Private storage key of the photo of the goods (optional).
  loadPhotoKey    String?
  // Floor at each end (0 = ground) and whether there is a lift there, and
  // whether the driver/helpers load at the pickup and unload at the drop-off.
  pickupFloor     Int?
  pickupHasLift   Boolean?
  dropoffFloor    Int?
  dropoffHasLift  Boolean?
  needsLoading    Boolean?
  needsUnloading  Boolean?

  pickupLat      Float
  pickupLng      Float
  pickupAddress  String
  dropoffLat     Float
  dropoffLng     Float
  dropoffAddress String

  estimatedDistanceMeters  Int
  estimatedDurationSeconds Int
  // The suggested price (from the fare table), shown to the passenger before
  // they request. For a negotiable ride this is only a starting point.
  estimatedFare            Int

  // Bidding (InDrive-style): what the passenger put forward when requesting
  // (defaults to estimatedFare if they did not change it), and whether this
  // ride is being matched by bidding at all (the business can run both modes
  // side by side; see RIDE_PRICING_MODE).
  offeredFare Int?
  negotiable  Boolean @default(false)
  // "Automatically accept the nearest driver for RsX": the first bid at or
  // below offeredFare is chosen right away instead of waiting for the
  // passenger to pick from the list.
  autoAccept  Boolean @default(false)

  // Filled in when the ride completes (B4). For a negotiable ride this is set
  // as soon as the passenger chooses an offer, and completion leaves it as is
  // (the agreed price does not get recalculated from the distance driven).
  distanceMeters  Int?
  durationSeconds Int?
  fare            Int?

  paymentMethod       PaymentMethod @default(cash)
  // Set when the ride completes: how much of the fare came out of the
  // passenger's wallet (the rest is cash), and the platform's commission.
  walletPaid          Int?
  commission          Int?
  cancelledBy         CancelledBy?
  // Which state the ride was in when it was cancelled (for cancellation statistics).
  cancelledFromStatus RideStatus?
  cancelReason        String?

  // Rates the passenger was quoted, so the final fare uses the same prices even
  // if an admin changes the fare config while the ride is in progress.
  rates Json?

  // Distance driven since the ride started, summed from the driver's location updates.
  trackedMeters Float  @default(0)
  lastLat       Float?
  lastLng       Float?

  // Matching: the search widens step by step until someone accepts or the request expires.
  searchStep         Int      @default(0)
  searchRadiusMeters Int
  nextExpandAt       DateTime
  expiresAt          DateTime

  requestedAt DateTime  @default(now())
  acceptedAt  DateTime?
  arrivedAt   DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  updatedAt   DateTime  @updatedAt

  passenger       User               @relation("RidePassenger", fields: [passengerId], references: [id])
  driver          User?              @relation("RideDriver", fields: [driverId], references: [id])
  vehicle         Vehicle?           @relation(fields: [vehicleId], references: [id])
  categoryRef     VehicleCategory    @relation(fields: [category], references: [key])
  offers          RideOffer[]
  ratings         RideRating[]
  cancellationLog RideCancellation[]
  earningEntries  DriverEarning[]
  messages        RideMessage[]
  reminders       BookingReminder[]
  safetyAlerts    SafetyAlert[]
  supportTickets  SupportTicket[]
  schedule        RideSchedule?      @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@unique([scheduleId, scheduledAt])
  @@index([passengerId, status])
  @@index([driverId, status])
  @@index([status, expiresAt])
  @@index([category])
  @@index([tripType])
  @@index([status, scheduledAt])
  @@map("rides")
}

// In-app chat between the passenger and the assigned driver. Only exists
// once a driver is assigned; see MESSAGING_ALLOWED in chat.service.ts for
// exactly when sending is allowed (reading the history is not time-limited).
model RideMessage {
  id        String   @id @default(uuid()) @db.Uuid
  rideId    String   @db.Uuid
  senderId  String   @db.Uuid
  body      String
  createdAt DateTime @default(now())

  ride   Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id])

  @@index([rideId, createdAt])
  @@map("ride_messages")
}

// One offer of a ride to one driver. The first driver to accept wins.
model RideOffer {
  id                     String      @id @default(uuid()) @db.Uuid
  rideId                 String      @db.Uuid
  driverId               String      @db.Uuid
  status                 OfferStatus @default(pending)
  distanceToPickupMeters Int
  etaSeconds             Int
  // Set once the driver answers a negotiable ride: their own price, or the
  // ride's offeredFare again if they chose to accept it as it stood.
  bidAmount              Int?
  offeredAt              DateTime    @default(now())
  expiresAt              DateTime
  respondedAt            DateTime?

  ride   Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)
  driver User @relation(fields: [driverId], references: [id])

  @@unique([rideId, driverId])
  @@index([driverId, status])
  @@map("ride_offers")
}

enum CancellationRole {
  passenger
  driver
}

// Every time someone backs out of a ride the other person was already waiting for.
// Used for the cool-down rule (too many in a short time) and for statistics.
model RideCancellation {
  id         String           @id @default(uuid()) @db.Uuid
  rideId     String           @db.Uuid
  userId     String           @db.Uuid
  role       CancellationRole
  fromStatus RideStatus
  reason     String?
  // Set by an admin to wipe the slate; forgiven rows no longer count.
  forgivenAt DateTime?
  createdAt  DateTime         @default(now())

  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, role, createdAt])
  @@map("ride_cancellations")
}

// One rating from one person on a ride to the other person on it.
model RideRating {
  id        String   @id @default(uuid()) @db.Uuid
  rideId    String   @db.Uuid
  raterId   String   @db.Uuid
  rateeId   String   @db.Uuid
  stars     Int
  comment   String?
  // The customer said the AC did not work (rides booked as an AC tier).
  acIssue   Boolean  @default(false)
  createdAt DateTime @default(now())

  ride  Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)
  rater User @relation("RatingRater", fields: [raterId], references: [id])
  ratee User @relation("RatingRatee", fields: [rateeId], references: [id])

  @@unique([rideId, raterId])
  @@index([rateeId])
  @@map("ride_ratings")
}

enum EarningType {
  ride_fare
  adjustment
  cashout
  // The platform's share of a ride (negative), taken from the driver's wallet.
  commission
}

// A driver's earnings ledger. Amounts are signed PKR. No commission is taken for
// now, so a completed ride adds its full fare. `cashout` is reserved for when
// wallets / online payments exist and is not shown in the app yet.
model DriverEarning {
  id        String      @id @default(uuid()) @db.Uuid
  driverId  String      @db.Uuid
  type      EarningType
  amount    Int
  rideId    String?     @db.Uuid
  note      String?
  createdAt DateTime    @default(now())

  driver User  @relation(fields: [driverId], references: [id])
  ride   Ride? @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@unique([rideId, type])
  @@index([driverId, createdAt])
  @@map("driver_earnings")
}

// ---------------------------------------------------------------------------
// Order tracking: follows an order placed in another system (FAZL APP) until it
// is delivered. The other system pushes the data in through the API.
// ---------------------------------------------------------------------------

// The steps an order moves through. Editable by an admin (spec: "the exact status
// structure should remain configurable"). `aliases` are the other system's own
// names for the same step, so it can keep sending its codes.
model OrderStatus {
  key       String   @id
  label     String
  position  Int
  terminal  Boolean  @default(false)
  active    Boolean  @default(true)
  aliases   String[]
  updatedAt DateTime @updatedAt

  orders TrackedOrder[]
  events OrderStatusEvent[]

  @@map("order_statuses")
}

model TrackedOrder {
  id         String @id @default(uuid()) @db.Uuid
  // Which system the order comes from, and its own id for it.
  source     String @default("fazl")
  externalId String

  customerRef   String?
  // Normalised phone of the customer, used to show the order in their History.
  customerPhone String?

  pickupAddress   String?
  pickupLat       Float?
  pickupLng       Float?
  deliveryAddress String
  deliveryLat     Float
  deliveryLng     Float

  statusKey String
  status    OrderStatus @relation(fields: [statusKey], references: [key])

  deliveryPersonId       String?
  deliveryPersonName     String?
  deliveryPersonPhone    String?
  deliveryPersonPhotoUrl String?
  deliveryPersonRating   Float?
  vehicleType            String?
  vehicleMake            String?
  vehicleModel           String?
  vehicleColor           String?
  vehiclePlate           String?

  // Last known position of the delivery person, and the other system's own ETA.
  lastLat        Float?
  lastLng        Float?
  lastHeading    Float?
  lastLocationAt DateTime?
  etaSeconds     Int?

  deliveredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  events OrderStatusEvent[]
  points OrderLocationPoint[]
  tokens TrackingToken[]

  @@unique([source, externalId])
  @@index([customerPhone])
  @@index([deliveryPersonId])
  @@index([statusKey])
  @@map("tracked_orders")
}

// The timeline: when each step was reached.
model OrderStatusEvent {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @db.Uuid
  statusKey String
  at        DateTime
  note      String?
  createdAt DateTime @default(now())

  order  TrackedOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status OrderStatus  @relation(fields: [statusKey], references: [key])

  @@index([orderId, at])
  @@map("order_status_events")
}

// A sampled trail of where the delivery went, for the admin's route view.
model OrderLocationPoint {
  id      String   @id @default(uuid()) @db.Uuid
  orderId String   @db.Uuid
  lat     Float
  lng     Float
  heading Float?
  at      DateTime

  order TrackedOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, at])
  @@map("order_location_points")
}

// What lets the customer's app open ONE order without logging in. Only a hash is
// stored; the token itself is shown once when the other system asks for it.
model TrackingToken {
  id         String    @id @default(uuid()) @db.Uuid
  orderId    String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  order TrackedOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("tracking_tokens")
}

// Things an admin should look at, e.g. a driver application waiting for
// review. Shown in the admin panel's notification bell.
model AdminNotification {
  id         String    @id @default(uuid()) @db.Uuid
  type       String
  title      String
  body       String
  targetType String?
  targetId   String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([createdAt])
  @@map("admin_notifications")
}

enum WalletTransactionType {
  topup
  ride_payment
  ride_earning
  commission
  change_sent
  change_received
  withdrawal
  withdrawal_reversal
  adjustment
  refund
  // Paid once when a driver reaches an achievement level.
  level_bonus
}

enum WalletRequestKind {
  topup
  withdrawal
}

enum WalletRequestStatus {
  pending
  approved
  rejected
  cancelled
}

// One balance per person, in whole PKR. A driver's balance can go below zero
// (commission on cash rides); a passenger's never does.
model Wallet {
  userId    String   @id @db.Uuid
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

// The wallet's ledger. Entries are never changed or deleted: a mistake is
// undone with an opposite entry. `key` makes every posting idempotent (one
// commission per ride, one credit per approved top-up...).
model WalletTransaction {
  id           String                @id @default(uuid()) @db.Uuid
  userId       String                @db.Uuid
  type         WalletTransactionType
  amount       Int
  balanceAfter Int
  key          String                @unique
  rideId       String?               @db.Uuid
  requestId    String?               @db.Uuid
  note         String?
  // The admin who made it (adjustments, approvals); null for the system.
  actorId      String?               @db.Uuid
  createdAt    DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("wallet_transactions")
}

// A top-up the person paid outside the app (bank / JazzCash / Easypaisa
// transfer) waiting for an admin to check it, or a withdrawal waiting to be
// paid out. A withdrawal's amount is held (taken off the balance) as soon as
// it is asked for and given back if it is rejected or cancelled.
model WalletRequest {
  id            String              @id @default(uuid()) @db.Uuid
  userId        String              @db.Uuid
  kind          WalletRequestKind
  status        WalletRequestStatus @default(pending)
  amount        Int
  // jazzcash, easypaisa, bank.
  method        String
  // Top-up: the transfer's transaction id. Withdrawal: the payout's, set by the admin.
  reference     String?
  // Private storage key of the transfer screenshot (top-up, optional).
  proofKey      String?
  // Withdrawal: where to send the money.
  accountTitle  String?
  accountNumber String?
  reviewedBy    String?             @db.Uuid
  reviewedAt    DateTime?
  rejectReason  String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, kind, createdAt])
  @@index([userId, createdAt])
  @@map("wallet_requests")
}

// Wallet rules, changed by admins without a release. Always a single row (id 1).
model WalletSettings {
  id                    Int      @id @default(1)
  // Platform's share of every completed ride's fare.
  commissionPercent     Float    @default(0)
  // A new driver's first rides (and freight jobs) carry no commission.
  freeRidesPerDriver    Int      @default(10)
  // A driver below this balance cannot go online until they top up.
  driverMinBalance      Int      @default(-500)
  minTopup              Int      @default(100)
  maxTopup              Int      @default(50000)
  minWithdrawal         Int      @default(1000)
  // The most a driver can put into a passenger's wallet as change.
  maxChange             Int      @default(500)
  walletPaymentsEnabled Boolean  @default(true)
  // Where to send a top-up (account titles and numbers), shown in the app.
  topupInstructions     String   @default("")
  updatedAt             DateTime @updatedAt

  @@map("wallet_settings")
}

// A phone that can receive push notifications (Firebase Cloud Messaging).
// One person may have several; a token moves to whoever signs in on that
// phone last. Tokens Firebase reports as dead are deleted.
model DeviceToken {
  token     String   @id
  userId    String   @db.Uuid
  // android or ios.
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

// Ride Later rules, changed by admins without a release. Always one row (id 1).
// Minutes are relative to the booked time. "ride" = within a city,
// "freight" = goods, "intercity" = a city to city ride.
model BookingSettings {
  id                   Int      @id @default(1)
  minAheadMinutes      Int      @default(30)
  maxAheadDays         Int      @default(7)
  maxPerPassenger      Int      @default(3)
  // Drivers see open bookings within this distance of where they last were.
  reservationRadiusKm  Int      @default(30)
  // When the confirmed driver may press Start: from this long before the
  // time until this long after it.
  rideStartBefore      Int      @default(60)
  rideStartAfter       Int      @default(30)
  freightStartBefore   Int      @default(90)
  freightStartAfter    Int      @default(60)
  intercityStartBefore Int      @default(120)
  intercityStartAfter  Int      @default(60)
  // Nobody confirmed yet: the customer is warned this long before (twice);
  // the booking closes at the booked time.
  rideWarnFirst        Int      @default(60)
  rideWarnSecond       Int      @default(30)
  freightWarnFirst     Int      @default(120)
  freightWarnSecond    Int      @default(60)
  intercityWarnFirst   Int      @default(360)
  intercityWarnSecond  Int      @default(120)
  // Reminders: both people this long before; the driver to press Start this
  // long before; and the evening before (hour of the day, business time).
  reminderMinutes      Int      @default(60)
  startNudgeMinutes    Int      @default(15)
  eveningReminderHour  Int      @default(21)
  // Giving up a confirmed booking this close to the time counts against the
  // driver, like not coming at all.
  lateReleaseMinutes   Int      @default(120)
  // This many no-shows / late releases within the window stop a driver
  // taking bookings for this many days.
  noShowLimit          Int      @default(3)
  noShowWindowDays     Int      @default(30)
  noShowBlockDays      Int      @default(7)
  // Frequent traveler: each day's booking is made this many hours ahead,
  // and a customer can keep this many schedules.
  scheduleAheadHours   Int      @default(24)
  maxSchedules         Int      @default(5)
  updatedAt            DateTime @updatedAt

  @@map("booking_settings")
}

// Which reminder already went out for a booking (each kind once).
model BookingReminder {
  rideId String   @db.Uuid
  kind   String
  sentAt DateTime @default(now())

  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@id([rideId, kind])
  @@map("booking_reminders")
}

// A place a customer keeps (Home, Work, or their own name) to book in one tap.
model SavedPlace {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  // home, work or other. At most one home and one work.
  kind      String
  label     String
  lat       Float
  lng       Float
  address   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_places")
}

// Frequent traveler: the same trip on chosen days at the same time (office,
// school). A booking for later is made for each day a while ahead and goes
// through the usual Ride Later flow (drivers offer, the customer confirms).
model RideSchedule {
  id             String        @id @default(uuid()) @db.Uuid
  passengerId    String        @db.Uuid
  name           String?
  pickupLat      Float
  pickupLng      Float
  pickupAddress  String
  dropoffLat     Float
  dropoffLng     Float
  dropoffAddress String
  category       String
  tripType       TripType      @default(within_city)
  // Days it runs, 1 = Monday ... 7 = Sunday.
  days           Int[]
  // Minutes after midnight, business time (8:30 = 510).
  timeMinutes    Int
  // What the customer offers each day; null = the suggested price.
  offeredFare    Int?
  paymentMethod  PaymentMethod @default(cash)
  active         Boolean       @default(true)
  // Driver confirmed last time: told first about the next day's booking.
  lastDriverId   String?       @db.Uuid
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  passenger User               @relation(fields: [passengerId], references: [id], onDelete: Cascade)
  rides     Ride[]
  skips     RideScheduleSkip[]

  @@index([active])
  @@index([passengerId])
  @@map("ride_schedules")
}

// A day a schedule should not run (holiday), as a business-time date.
model RideScheduleSkip {
  scheduleId String   @db.Uuid
  date       String
  createdAt  DateTime @default(now())

  schedule RideSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@id([scheduleId, date])
  @@map("ride_schedule_skips")
}

// Driver achievement levels (Silver 500 rides, Gold 1,000, Platinum 3,000),
// edited by admins. Lifetime: completed trips (rides and freight) only ever
// go up, so a level is never lost. Each level carries rewards.
model DriverLevel {
  key                String   @id
  name               String
  // Completed trips needed.
  minRides           Int
  // Badge colour (hex) and icon for the apps.
  color              String   @default("#9CA3AF")
  icon               String   @default("star")
  active             Boolean  @default(true)
  // Rewards. Percentage points off the commission on every trip.
  commissionDiscount Float    @default(0)
  // Paid into the wallet once, when the level is reached.
  bonus              Int      @default(0)
  // Counts as this many metres closer when choosing who gets a request.
  priorityMeters     Int      @default(0)
  // A lower dues limit than everyone else's (e.g. -1000); null = the usual.
  minBalance         Int?
  // Rewards only written down (free car wash...), handed out by the team.
  perks              String[] @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("driver_levels")
}

enum SafetyAlertStatus {
  // Raised, nobody at FAZL has picked it up yet.
  open
  // Support is on it (has called, is watching the location).
  acknowledged
  // Support closed it, with what happened.
  resolved
  // The person said they are safe before support closed it.
  cancelled
}

// An SOS from a passenger or a driver: who, on which ride, and where they
// are (kept fresh while the alert is open). Support sees it in the admin
// panel straight away.
model SafetyAlert {
  id               String            @id @default(uuid()) @db.Uuid
  userId           String            @db.Uuid
  // 'passenger' or 'driver' on this ride.
  role             String
  rideId           String?           @db.Uuid
  status           SafetyAlertStatus @default(open)
  lat              Float
  lng              Float
  locationAt       DateTime          @default(now())
  acknowledgedAt   DateTime?
  acknowledgedById String?           @db.Uuid
  resolvedAt       DateTime?
  resolvedById     String?           @db.Uuid
  resolution       String?
  // When the safety team was alerted again because nobody took it.
  realertedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  user User  @relation("SafetyAlertUser", fields: [userId], references: [id])
  ride Ride? @relation(fields: [rideId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, status])
  @@map("safety_alerts")
}

// Who gets an SOS on their phone (a loud push), by phone number: they need
// the FAZL Ride app signed in with that number. Kept by number, not user, so
// someone can be added before they first sign in.
model SafetyTeamMember {
  id        String   @id @default(uuid()) @db.Uuid
  phone     String   @unique
  label     String?
  createdAt DateTime @default(now())

  @@map("safety_team_members")
}

enum SupportTicketStatus {
  // New, nobody at FAZL has answered yet.
  open
  // Support answered or is looking into it.
  in_progress
  // Support closed it with what was done.
  resolved
}

enum SupportPriority {
  low
  medium
  high
  urgent
}

// A complaint or question from a passenger or a driver, usually about one
// ride (Careem/Uber "Help with this trip"). The conversation is in
// support_messages; support closes it with what was done (and may refund).
model SupportTicket {
  id             String              @id @default(uuid()) @db.Uuid
  // Shown to people as #FZ-000123.
  number         Int                 @unique @default(autoincrement())
  userId         String              @db.Uuid
  // 'passenger' or 'driver' on that ride (or in the app).
  role           String
  rideId         String?             @db.Uuid
  // The other person on the ride, if the complaint is about them.
  againstUserId  String?             @db.Uuid
  category       String
  priority       SupportPriority
  status         SupportTicketStatus @default(open)
  description    String
  assignedToId   String?             @db.Uuid
  firstReplyAt   DateTime?
  resolvedAt     DateTime?
  resolvedById   String?             @db.Uuid
  resolution     String?
  // Whole PKR put into the person's wallet when it was resolved.
  refundAmount   Int?
  // Last time the person or support wrote, for sorting.
  lastActivityAt DateTime            @default(now())
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  user     User             @relation("TicketUser", fields: [userId], references: [id])
  against  User?            @relation("TicketAgainst", fields: [againstUserId], references: [id])
  ride     Ride?            @relation(fields: [rideId], references: [id], onDelete: SetNull)
  messages SupportMessage[]

  @@index([status, priority, createdAt])
  @@index([userId, createdAt])
  @@index([rideId])
  @@map("support_tickets")
}

model SupportMessage {
  id          String   @id @default(uuid()) @db.Uuid
  ticketId    String   @db.Uuid
  authorId    String   @db.Uuid
  // Written by FAZL support (shown as "FAZL Support", never the admin's name).
  fromSupport Boolean
  body        String
  createdAt   DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id])

  @@index([ticketId, createdAt])
  @@map("support_messages")
}
