NODE_ENV=development
PORT=3000

# Pooled URL for the app. Direct/session-pooler URL for migrations (Supabase).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fazl?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/fazl?schema=public"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me
OTP_SECRET=change-me
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
OTP_TTL_SECONDS=300

# Comma-separated phones (E.164) that get the super_admin role after OTP login
SUPER_ADMIN_PHONES=+923000000000

# --- Supabase (used only as Postgres + object storage; not Auth / RLS) ---
# To use Supabase as the database, replace the two URLs above:
#   DATABASE_URL = Transaction pooler string (port 6543)
#   DIRECT_URL   = Session pooler string (port 5432, user postgres.<project-ref>)
# Do not use the db.<ref>.supabase.co direct host: it is IPv6-only (fails on IPv4 networks and on Render).
# Add ?sslmode=require to both if the connection is refused.
SUPABASE_URL=https://<project-ref>.supabase.co
# Server-side secret. Never ship it in the mobile app or commit it.
SUPABASE_SERVICE_ROLE_KEY=
# Create this bucket in the Supabase dashboard and keep it PRIVATE.
SUPABASE_BUCKET=driver-documents
